// Lingju Modeling Tools - drag and drop installer.
// Drop this file into the Maya viewport: it installs the lingju_tools package
// of the CURRENT Maya version from <this folder>/<version>/ into the user's
// maya scripts folder and creates the launch button on the LINGJU shelf tab.
// If Maya cannot tell us where this file lives, a folder picker asks once for
// the folder that contains install.mel and lingju_installer.py.
// Any error is shown in a dialog instead of failing silently.
// All logic (and all Chinese messages) lives in lingju_installer.py.
// Generated by build_pyd.py - do not edit by hand.
global proc lingjuInstallBootstrap(){}
python("import os, sys, importlib, traceback, maya.cmds as mc, maya.mel as m;\ntry:\n    info = m.eval('whatIs \"lingjuInstallBootstrap\"') or ''\n    p = info.rsplit(': ', 1)[-1].strip().strip('\"') if ': ' in info else ''\n    r = os.path.dirname(p) if p else ''\n    if not r or not os.path.isfile(os.path.join(r, 'lingju_installer.py')):\n        picked = mc.fileDialog2(dialogStyle=2, fileMode=2, okCaption='Install', caption='Select the folder that contains install.mel and lingju_installer.py', startingDirectory=os.path.expanduser('~'))\n        if not picked:\n            raise RuntimeError('Install cancelled: no installer folder selected')\n        r = picked[0]\n    assert os.path.isfile(os.path.join(r, 'lingju_installer.py')), 'lingju_installer.py was not found in: ' + r\n    sys.path.insert(0, r)\n    importlib.invalidate_caches()\n    sys.modules.pop('lingju_installer', None)\n    importlib.import_module('lingju_installer').install(r)\nexcept Exception:\n    mc.confirmDialog(title='Lingju installer error', message=traceback.format_exc()[-1800:], button=['OK'])\n");
