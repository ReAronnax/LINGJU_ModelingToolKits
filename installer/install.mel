// Lingju Modeling Tools - drag and drop installer.
// Drop this file into the Maya main window: it copies the lingju_tools package
// of the CURRENT Maya version from <this folder>/<version>/ into the user's
// maya scripts folder and creates the launch button on the LINGJU shelf tab.
// Unsupported Maya versions are reported and nothing is copied.
// All logic (and all Chinese messages) lives in lingju_installer.py, keep them together.
// Generated by build_pyd.py - do not edit by hand.
global proc lingjuInstallBootstrap(){}
python("import os, sys, importlib, maya.mel as m; p = (m.eval('whatIs \"lingjuInstallBootstrap\"') or '').rsplit(chr(58)+chr(32), 1)[-1].strip().strip(chr(34)); r = os.path.dirname(p); assert os.path.isfile(os.path.join(r, 'lingju_installer.py')), 'lingju_installer.py must stay in the same folder as install.mel: ' + r; sys.path.insert(0, r); importlib.invalidate_caches(); sys.modules.pop('lingju_installer', None); importlib.import_module('lingju_installer').install(r)");
